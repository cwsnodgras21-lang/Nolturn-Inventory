# Nolt Inventory — environment variable template
# Copy to `.env.local` for local development. Never commit secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nolt Inventory

# Supabase (after `npm run supabase:start`, copy from `npx supabase status -o env`)
# Local ports are offset (56421+) to avoid collisions with other Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
# Preferred publishable key (falls back to anon key via centralized env resolver)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to 1 when running RLS integration tests against local Supabase
# RUN_RLS_TESTS=1

# Phase 8+ — Stripe (not wired)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 9+ — PandaDoc (not wired)
# PANDADOC_API_KEY=
# PANDADOC_WEBHOOK_SECRET=

# Phase 7+ — Nolt providers (not wired)
# NOLT_PROVIDER=
# NOLT_API_KEY=
